[Unit]
Description=Gunicorn instance serving the DSW KM integrations API
After=network.target

[Service]
# ---- USER / GROUP -------------------------------------------------
# Run as a non-root user for safety. www-data is common on Debian/Ubuntu.
User=www-data
Group=www-data

# ---- WORKING DIRECTORY --------------------------------------------
# The whole app (wsgi.py + services/ package) is deployed here.
WorkingDirectory=/opt/integrations

# ---- ENVIRONMENT --------------------------------------------------
# Mark as production so the app skips dev-only dotenv loading.
Environment=ENV=production
# Load .env if present (optional, useful for secrets). The leading "-"
# means a missing file does not fail the unit.
EnvironmentFile=-/opt/integrations/.env

# ---- EXECUTION ----------------------------------------------------
# One Gunicorn process serves every integration (mounted as blueprints):
#   /policies/...               (policy-search)
#   /datacite/relationtype/...  (DataCite relationType)
#   /health
# Adjust the path if gunicorn lives in a venv.
ExecStart=/usr/bin/gunicorn \
          -w 3 \
          --threads 4 \
          --preload \
          --bind 0.0.0.0:80 \
          wsgi:application

# Allow binding to the privileged port 80 as a non-root user.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# ---- RESTART POLICY -----------------------------------------------
Restart=on-failure
RestartSec=5

# ---- LOGGING ------------------------------------------------------
# Journal will capture stdout / stderr (view with: journalctl -u integrations).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
